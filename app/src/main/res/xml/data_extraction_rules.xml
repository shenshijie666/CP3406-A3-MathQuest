<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!-- Protects learning data from cloud backups. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>

    <!-- Protects learning data during device transfers. -->
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>

</data-extraction-rules>
